# Dependencies and package-manager caches (keep lockfiles tracked)
node_modules/
/.pnp
.pnp.*
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test output
/coverage/
/playwright-report/
/test-results/
.nyc_output/
/playwright/.cache/

# Build output and caches
.next/
/out/
/build/
/dist/
.cache/
.turbo/
.swc/
.eslintcache
.stylelintcache

# Operating-system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
/.vscode/
.history/
*.swp
*.swo
*~
*.orig

# Logs and diagnostic reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
report.*.json

# Environment files
.env*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Private keys and local credential configuration
*.pem
*.key
*.p12
*.pfx
/.npmrc
/.netrc
/_netrc
/.aws/
/.ssh/

# Local deployment configuration
.vercel/
.netlify/

# Generated TypeScript files
*.tsbuildinfo
next-env.d.ts
